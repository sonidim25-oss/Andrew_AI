[Unit]
Description=Andrew rootless disposable tool runner
Requires=srv-andrew-workspace-projects.mount andrew-runner.socket andrew-runtime-firewall.service
After=andrew-runner.socket andrew-runtime-firewall.service

[Service]
Type=simple
User=andrew-runtime
Group=andrew-runtime
WorkingDirectory=/opt/andrew/runtime-services
Environment=PYTHONPATH=/opt/andrew/runtime-services
Environment=HOME=/var/lib/andrew/runtime
Environment=ANDREW_CGROUP_PARENT=/system.slice/%n
EnvironmentFile=/etc/andrew/runner-environment.conf
Environment=ANDREW_RUNNER_CONFIG=/etc/andrew/runner.conf
LoadCredentialEncrypted=andrew-runner-receipts-key:/etc/credstore.encrypted/andrew-runner-receipts-key
ExecStart=/usr/bin/python3 -m andrewbot.runner_service
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
# Hide other homes while the UID-specific drop-in exposes only our runroot.
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
Delegate=yes
DelegateSubgroup=supervisor
ReadWritePaths=/var/lib/andrew/runtime /srv/andrew/workspace/projects /sys/fs/cgroup
MemoryMax=3G
CPUQuota=250%
TasksMax=512
LimitNOFILE=2048
