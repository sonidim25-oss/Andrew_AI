#!/usr/bin/env bash
# Owner-only Gmail setup. Tokens/client secrets never enter argv or chat.
set -euo pipefail
if [ "$(id -u)" -ne 0 ]; then echo 'Use sudo from an interactive SSH terminal.' >&2; exit 2; fi
cd /
if [ ! -f /opt/andrew/prototype/andrewbot/gmail_admin.py ]; then
  echo 'Install the Gmail controller source with enable-browser-runtime.sh first.' >&2; exit 2
fi
action="${1:-status}"
if [ "$#" -gt 0 ]; then shift; fi
if [ "$action" = permissions ]; then
  exec env PYTHONPATH=/opt/andrew/prototype /usr/bin/python3 -m andrewbot.gmail_admin permissions "$@"
fi
credentials=()
module=andrewbot.gmail_admin
arguments=("$action")
if [ "$action" = connect ]; then
  if [ "$#" -ne 1 ] || [[ "$1" != /* ]] || [ ! -f "$1" ]; then
    echo 'Usage: sudo bash scripts/andrew-gmail connect /absolute/path/desktop-client.json' >&2; exit 2
  fi
  client_path="$(realpath -- "$1")"
  # systemd loads the private file for the service identity without changing ACLs.
  credentials+=("--property=LoadCredential=gmail-oauth-client:$client_path")
  env PYTHONPATH=/opt/andrew/prototype /usr/bin/python3 -m andrewbot.gmail_admin prepare-connect
  module=andrewbot.gmail_oauth
  arguments=()
elif [[ "$action" != status && "$action" != disconnect && "$action" != verify-read ]] || [ "$#" -ne 0 ]; then
  echo 'Commands: connect CLIENT_JSON | permissions [CAPABILITY on|off] | status | disconnect | verify-read' >&2; exit 2
fi
exec systemd-run --wait --pty --collect --quiet --unit=andrew-gmail-admin \
  --uid=andrew-control --gid=andrew-control \
  --property=WorkingDirectory=/opt/andrew/prototype \
  --property=Environment=PYTHONPATH=/opt/andrew/prototype \
  --property=LoadCredentialEncrypted=andrew-vault-key:/etc/credstore.encrypted/andrew-vault-key \
  --property=UMask=0077 --property=NoNewPrivileges=yes \
  --property=ProtectSystem=strict --property=ProtectHome=yes \
  --property=ReadWritePaths=/var/lib/andrew/vault --property=RuntimeMaxSec=360 \
  "${credentials[@]}" /usr/bin/python3 -m "$module" "${arguments[@]}"
